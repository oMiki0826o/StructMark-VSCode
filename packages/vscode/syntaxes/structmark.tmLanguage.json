{
  "scopeName": "source.structmark",
  "patterns": [
    {"name":"markup.heading.structmark","match":"^\\s{0,3}#[1-6][ \\t]+.*$"},
    {"name":"keyword.control.directive.end.structmark","match":"^\\s{0,3}&(?:e|end)\\s*$"},
    {"name":"keyword.control.directive.structmark","match":"^\\s{0,3}&[a-z][a-z0-9_-]*(?:\\[[^\\]\\n]*\\])?"},
    {"name":"entity.name.section.structmark","match":"\\(#[a-z][a-z0-9_-]*\\)"},
    {"name":"markup.underline.link.structmark","match":"\\(#[^()\\s]+\\.sm#[a-z][a-z0-9_-]*\\)"},
    {"name":"markup.bold.structmark","match":"\\*\\[[^\\]\\n]*\\]"},
    {"name":"markup.italic.structmark","match":"/\\[[^\\]\\n]*\\]"},
    {"name":"markup.underline.structmark","match":"-\\[[^\\]\\n]*\\]"},
    {"name":"markup.deleted.structmark","match":"~\\[[^\\]\\n]*\\]"},
    {"name":"markup.highlight.structmark","match":"=\\[[^\\]\\n]*\\]"},
    {"name":"comment.line.structmark","match":"^\\s*%%.*$"}
  ]
}

{
  "name": "structmark-language-core",
  "version": "2.0.0-rc.1",
  "type": "module",
  "description": "StructMark v2 candidate engine and backwards-compatible v1.6 toolchain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oMiki0826o/StructMark.git"
  },
  "bugs": {
    "url": "https://github.com/oMiki0826o/StructMark/issues"
  },
  "homepage": "https://omiki0826o.github.io/StructMark/",
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs",
    "examples",
    "src/v2",
    "experimental/v2",
    "VALIDATION.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./src/v2/index.d.mts",
      "import": "./src/v2/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "fuzz": "npm run build && node scripts/fuzz.mjs",
    "benchmark:tokens": "python3 benchmark/tokens.py",
    "benchmark:perf": "npm run build && node scripts/perf.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "check": "npm test && npm run fuzz",
    "prepublishOnly": "npm run build && npm test",
    "cli": "npm run build && node bin/structmark.mjs",
    "test:cli": "npm run build && node --test tests/cli-v13.test.mjs tests/v13-integration.test.mjs",
    "docs:check": "npm run build && node scripts/docs-check.mjs",
    "docs:export": "npm run build && node scripts/docs-check.mjs --export",
    "test:v2": "node --test experimental/v2/tests/*.test.mjs",
    "cli:v2": "node bin/sm2.mjs",
    "test:v2:cli": "node --test experimental/v2/tests/cli.test.mjs",
    "check:v2": "npm run test:v2 && npm run fuzz:v2 && node scripts/validate-vscode-assets.mjs",
    "prepare:vscode": "node scripts/prepare-vscode.mjs",
    "fuzz:v2": "node scripts/v2-fuzz.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "yaml": "^2.9.1"
  },
  "bin": {
    "structmark": "./bin/structmark.mjs",
    "sm2": "./bin/sm2.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
